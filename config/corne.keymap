 * SPDX-License-Identifier: MIT
 *
 * BÉPO layout for Corne 42-key (3x6 + 3 thumbs per side)
 * ZMK sends US HID keycodes — BÉPO mapping is handled by the OS.
 * Each key is commented with the expected BÉPO character.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define FN   3

&nice_view_spi {
        cs-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>;
};

/ {
        behaviors {
                hm: homerow_mods {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <250>;
                        require-prior-idle-ms = <150>;
                        flavor = "balanced";
                        bindings = <&kp>, <&kp>;
                };
        };

        combos {
                compatible = "zmk,combos";
                combo_esc {
                        timeout-ms = <50>;
                        key-positions = <19 20>;  /* T + S (BEPO) = J + K (physical) -> Escape */
                        bindings = <&kp ESC>;
                };
                combo_caps_word {
                        timeout-ms = <50>;
                        key-positions = <38 39>;  /* Space + Enter -> Caps Lock (toggle) */
                        bindings = <&kp CAPS>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        // BEPO base layer (OS interprets HID US -> BEPO)
                        // ,-----+-----+-----+-----+-----+-----.   ,-----+-----+-----+-----+-----+-----.
                        // |  W  |  B  |  E' |  P  |  O  |  E` |   |  ^  |  V  |  D  |  L  |  J  |  Z  |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |  C, |A/GUI|U/ALT|I/CTL|E/SHF|  ,  |   |  C  |T/SHF|S/CTL|R/ALT|N/GUI|  M  |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |  $  |  A` |  Y  |  X  |  .  |  K  |   |  '  |  Q  |  G  |  H  |  F  |⇧ OSS|
                        // `-----+-----+-----+-----+-----+-----'   `-----+-----+-----+-----+-----+-----'
                        //                   |SH/NV|BKSP | SPC |   | ENT | SYM |DL/FN|
                        //                   `-----+-----+-----'   `-----+-----+-----'
                        bindings = <
                                &kp RBKT     &kp Q        &kp W        &kp E        &kp R        &kp T           &kp Y        &kp U        &kp I        &kp O         &kp P       &kp LBKT
                                &kp BSLH     &hm LGUI A   &hm LALT S   &hm LCTRL D  &hm LSHFT F  &kp G           &kp H        &hm RSHFT J  &hm RCTRL K  &hm RALT L    &hm RGUI SEMI &kp SQT
                                &kp GRAVE    &kp Z        &kp X        &kp C        &kp V        &kp B           &kp N        &kp M        &kp COMMA    &kp DOT       &kp FSLH    &sk LSHFT
                                                                        &lt NAV LSHFT &kp BSPC    &kp SPACE       &kp RET      &mo SYM      &lt FN DEL
                        >;
                };

                nav_layer {
                        // Navigation: vim arrows, page nav, clipboard shortcuts
                        // ,-----+-----+-----+-----+-----+-----.   ,-----+-----+-----+-----+-----+-----.
                        // |     |     |     |     |     |     |   |     |HOME |PGDN |PGUP | END | INS |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |     | GUI | ALT | CTL | SHF |     |   |     |  <- | DWN |  UP |  -> |     |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |     | C-Z | C-X | C-C | C-V |     |   | TAB |S-TAB|     |     |     |     |
                        // `-----+-----+-----+-----+-----+-----'   `-----+-----+-----+-----+-----+-----'
                        //                   | ___ | ___ | ___ |   | ___ | ___ | ___ |
                        //                   `-----+-----+-----'   `-----+-----+-----'
                        bindings = <
                                &trans       &trans       &trans       &trans       &trans       &trans          &trans       &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp INS
                                &trans       &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &trans          &trans       &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &trans
                                &trans       &kp LC(LBKT) &kp LC(C)    &kp LC(H)    &kp LC(U)    &trans          &kp TAB      &kp LS(TAB)  &trans       &trans       &trans       &trans
                                                                        &trans       &trans       &trans          &trans       &trans       &trans
                        >;
                };

                sym_layer {
                        // Symbols: digits + programming symbols (via BEPO OS mapping)
                        // BEPO OS: LS(Nx) -> digit, bare Nx -> symbol, RA(x) -> AltGr symbol
                        // ,-----+-----+-----+-----+-----+-----.   ,-----+-----+-----+-----+-----+-----.
                        // |  `  |  #  |  1  |  2  |  3  |  4  |   |  5  |  6  |  7  |  8  |  9  |  0  |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |  =  |  @  |  |  |  &  |  (  |  )  |   |  [  |  ]  |  {  |  }  |  ~  |  \  |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |     |  <  |  >  |  +  |  -  |  /  |   |  *  |  "  |  << |  >> |  %  |     |
                        // `-----+-----+-----+-----+-----+-----'   `-----+-----+-----+-----+-----+-----'
                        //                   | ___ | ___ | ___ |   | ___ | ___ | ___ |
                        //                   `-----+-----+-----'   `-----+-----+-----'
                        bindings = <
                                &kp LS(EQUAL) &kp LS(GRAVE) &kp LS(N1) &kp LS(N2)   &kp LS(N3)   &kp LS(N4)      &kp LS(N5)   &kp LS(N6)   &kp LS(N7)   &kp LS(N8)   &kp LS(N9)   &kp LS(N0)
                                &kp MINUS    &kp N6        &kp RA(Q)  &kp RA(E)    &kp N4       &kp N5          &kp RA(N4)   &kp RA(N5)   &kp RA(X)    &kp RA(C)    &kp RA(B)    &kp RA(Z)
                                &trans       &kp RA(N2)    &kp RA(N3) &kp N7       &kp N8       &kp N9          &kp N0       &kp N1       &kp N2       &kp N3       &kp EQUAL    &trans
                                                                        &trans       &trans       &trans          &trans       &trans       &trans
                        >;
                };

                fn_layer {
                        // Function keys, Bluetooth, media controls, system
                        // ,-----+-----+-----+-----+-----+-----.   ,-----+-----+-----+-----+-----+-----.
                        // |     | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 | F11 |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // | F12 | BT0 | BT1 | BT2 |BTCLR|     |   |     |PREV |VOL- |VOL+ |NEXT |     |
                        // |-----+-----+-----+-----+-----+-----|   |-----+-----+-----+-----+-----+-----|
                        // |     |     |     |     |     |BOOT |   |RESET|PLAY |MUTE |     |     |     |
                        // `-----+-----+-----+-----+-----+-----'   `-----+-----+-----+-----+-----+-----'
                        //                   | ___ | ___ | ___ |   | ___ | ___ | ___ |
                        //                   `-----+-----+-----'   `-----+-----+-----'
                        bindings = <
                                &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5          &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F11
                                &kp F12      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR  &trans          &trans       &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   &trans
                                &trans       &trans       &trans       &trans       &trans       &bootloader     &sys_reset   &kp C_PP     &kp C_MUTE   &trans       &trans       &trans
                                                                        &trans       &trans       &trans          &trans       &trans       &trans
                        >;
                };
        };
};
